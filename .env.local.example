# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Aiven PostgreSQL. Copy the service connection URI from Aiven.
# Aiven requires TLS; sslmode=require is supported by the URI.
DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_HOST:PORT/defaultdb?sslmode=require
# Optional: path to Aiven CA for certificate verification (recommended for verify-ca/verify-full).
AIVEN_POSTGRES_CA_PATH=
PG_POOL_MAX=5

# Portfolio owner / public content seed defaults
PORTFOLIO_NAME=Shivam Sharma
CONTACT_EMAIL=shivam1234sharmabro@gmail.com
CONTACT_PHONE=+91 7004942929
CONTACT_LOCATION=Jamtara, Jharkhand (India)
CONTACT_AVAILABILITY=Open to Work
GITHUB_URL=https://github.com/Shivamsharma-builds
LINKEDIN_URL=https://linkedin.com/in/shivam-sharma-332179357
TWITTER_URL=https://x.com/ShivamSharjmt23

# Resend
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM="Shivam Sharma <onboarding@resend.dev>"

# Admin authentication
ADMIN_EMAIL=admin@example.com
# Generate with: npm run admin:hash -- "your-strong-password"
ADMIN_PASSWORD_HASH=scrypt$replace$replace
# Use a long random secret in production.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
